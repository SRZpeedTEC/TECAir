@baseUrl = http://localhost:5000

### 1. Health check
# Esperado: 200 OK
GET {{baseUrl}}/health
Accept: application/json


### 2. GET todos los itinerarios con promociones para admin
# Esperado: 200 OK.
# Debe incluir itinerarios EDITION y PUBLIC, cada uno con state, promotion o null, y flights.
GET {{baseUrl}}/api/itineraries/with-promotions
Accept: application/json


### 3. Obtener itinerary por id con promocion
# itinerary_id = 1 tiene PROMO-PANAMA-15 en los datos semilla.
# Esperado: 200 OK con state, promotion y flights con itineraryFlightId.
GET {{baseUrl}}/api/itineraries/1
Accept: application/json


### 4. Obtener itinerary por id sin promocion
# itinerary_id = 5 no tiene promocion en los datos semilla.
# Esperado: 200 OK con promotion = null y flights con itineraryFlightId.
GET {{baseUrl}}/api/itineraries/5
Accept: application/json


### 5. Preparar itinerary PUBLIC para probar vista usuario
# @name crearItinerarioPublico
# Esperado: 201 Created.
POST {{baseUrl}}/api/itineraries
Content-Type: application/json
Accept: application/json

{
  "price": 120,
  "state": "PUBLIC",
  "flights": [
    {
      "flightId": 3,
      "flightOrder": 1
    }
  ]
}


### 6. GET solo itinerarios PUBLIC con promociones para usuario
# Esperado: 200 OK.
# Todos los elementos deben venir con state = PUBLIC.
GET {{baseUrl}}/api/itineraries/public/with-promotions
Accept: application/json


### 7. Confirmar que el itinerary PUBLIC creado viene con state y promotion null
# Esperado: 200 OK con state = PUBLIC, promotion = null y flights[0].itineraryFlightId.
GET {{baseUrl}}/api/itineraries/{{crearItinerarioPublico.response.body.$.itineraryId}}
Accept: application/json


### 8. Actualizar itinerario EDITION con precio, state y vuelos validos
# Esperado: 200 OK.
# itineraryId viene de la ruta; el body reemplaza precio, state y lista ordenada.
PUT {{baseUrl}}/api/itineraries/4
Content-Type: application/json
Accept: application/json

{
  "price": 700,
  "state": "EDITION",
  "flights": [
    {
      "flightId": 2,
      "flightOrder": 1
    },
    {
      "flightId": 3,
      "flightOrder": 2
    }
  ]
}


### 9. Actualizar itinerario inexistente
# Esperado: 404 Not Found.
PUT {{baseUrl}}/api/itineraries/9999
Content-Type: application/json
Accept: application/json

{
  "price": 700,
  "state": "PUBLIC",
  "flights": [
    {
      "flightId": 1,
      "flightOrder": 1
    }
  ]
}


### 10. Actualizar itinerario con state invalido
# Esperado: 400 Bad Request.
PUT {{baseUrl}}/api/itineraries/2
Content-Type: application/json
Accept: application/json

{
  "price": 700,
  "state": "DRAFT",
  "flights": [
    {
      "flightId": 1,
      "flightOrder": 1
    }
  ]
}


### 11. Actualizar itinerario EDITION con lista de vuelos vacia
# Esperado: 400 Bad Request.
PUT {{baseUrl}}/api/itineraries/4
Content-Type: application/json
Accept: application/json

{
  "price": 700,
  "state": "PUBLIC",
  "flights": []
}


### 12. Actualizar itinerario EDITION con flightOrder duplicado
# Esperado: 409 Conflict.
PUT {{baseUrl}}/api/itineraries/4
Content-Type: application/json
Accept: application/json

{
  "price": 700,
  "state": "PUBLIC",
  "flights": [
    {
      "flightId": 1,
      "flightOrder": 1
    },
    {
      "flightId": 2,
      "flightOrder": 1
    }
  ]
}


### 13. Actualizar itinerario EDITION con flightId duplicado
# Esperado: 409 Conflict.
PUT {{baseUrl}}/api/itineraries/4
Content-Type: application/json
Accept: application/json

{
  "price": 700,
  "state": "PUBLIC",
  "flights": [
    {
      "flightId": 1,
      "flightOrder": 1
    },
    {
      "flightId": 1,
      "flightOrder": 2
    }
  ]
}


### 14. Actualizar itinerario EDITION con conexion ilogica
# Vuelo 1 llega a PTY y vuelo 4 sale de SJO.
# Esperado: 400 Bad Request.
PUT {{baseUrl}}/api/itineraries/4
Content-Type: application/json
Accept: application/json

{
  "price": 700,
  "state": "PUBLIC",
  "flights": [
    {
      "flightId": 1,
      "flightOrder": 1
    },
    {
      "flightId": 4,
      "flightOrder": 2
    }
  ]
}


### 15. Preparar vuelo para probar escala de mas de un dia
# @name crearVueloEscalaLarga
# Vuelo 4 llega a MIA el 2026-06-12 a las 14:00; este sale mas de un dia despues.
POST {{baseUrl}}/api/flights
Content-Type: application/json
Accept: application/json

{
  "planePlate": "TI-TEC03",
  "airportDepartsFromId": "MIA",
  "airportArrivesToId": "MEX",
  "state": "OPEN",
  "gate": "M8",
  "departureDatetime": "2026-06-14T15:00:00",
  "arrivalDatetime": "2026-06-14T18:00:00"
}


### 16. Actualizar itinerario EDITION con mas de un dia entre vuelos consecutivos
# Esperado: 400 Bad Request.
PUT {{baseUrl}}/api/itineraries/4
Content-Type: application/json
Accept: application/json

{
  "price": 800,
  "state": "PUBLIC",
  "flights": [
    {
      "flightId": 4,
      "flightOrder": 1
    },
    {
      "flightId": {{crearVueloEscalaLarga.response.body.$.flightId}},
      "flightOrder": 2
    }
  ]
}


### 17. Preparar itinerario sin reservaciones para borrar
# @name crearItinerarioParaBorrar
# Esperado: 201 Created.
POST {{baseUrl}}/api/itineraries
Content-Type: application/json
Accept: application/json

{
  "price": 95,
  "state": "EDITION",
  "flights": [
    {
      "flightId": 3,
      "flightOrder": 1
    }
  ]
}


### 18. Eliminar itinerario PUBLIC creado para pruebas
# Esperado: 204 No Content.
DELETE {{baseUrl}}/api/itineraries/{{crearItinerarioPublico.response.body.$.itineraryId}}
Accept: application/json


### 19. Eliminar itinerario existente sin reservaciones
# Esperado: 204 No Content.
DELETE {{baseUrl}}/api/itineraries/{{crearItinerarioParaBorrar.response.body.$.itineraryId}}
Accept: application/json


### 20. Eliminar itinerario inexistente
# Esperado: 404 Not Found.
DELETE {{baseUrl}}/api/itineraries/9999
Accept: application/json


### 21. Eliminar itinerario con reservaciones
# Itinerario 1 tiene reservaciones en los datos semilla.
# Esperado: 409 Conflict.
DELETE {{baseUrl}}/api/itineraries/1
Accept: application/json


### 22. Disponibilidad para itinerario PUBLIC con 1 pasajero
# Esperado: 200 OK con canReserve = true si quedan espacios.
GET {{baseUrl}}/api/itineraries/1/availability?passengers=1
Accept: application/json


### 23. Disponibilidad con pasajeros mayor al cupo disponible
# Esperado: 200 OK con canReserve = false.
GET {{baseUrl}}/api/itineraries/1/availability?passengers=9999
Accept: application/json


### 24. Disponibilidad para itinerario CLOSED
# itinerary_id = 5 esta CLOSED en datos semilla.
# Esperado: 200 OK con availableSeats = 0 y canReserve = false.
GET {{baseUrl}}/api/itineraries/5/availability?passengers=1
Accept: application/json


### 25. Disponibilidad con valor invalido de pasajeros
# Esperado: 400 Bad Request.
GET {{baseUrl}}/api/itineraries/1/availability?passengers=0
Accept: application/json


### 26. Busqueda publica no devuelve itinerarios CLOSED
# Esperado: 200 OK sin itineraryId = 5.
GET {{baseUrl}}/api/itineraries/search?originCode=MIA&destinationCode=MEX
Accept: application/json


### 27. Busqueda administrativa puede incluir CLOSED si lo solicita
# Esperado: 200 OK incluyendo itineraryId = 5.
GET {{baseUrl}}/api/itineraries/admin/search?departureCode=MIA&arrivalCode=MEX
Accept: application/json


### 28. Preparar itinerario EDITION para publicar
# @name crearItinerarioEditionParaPublicar
# Esperado: 201 Created con state = EDITION.
POST {{baseUrl}}/api/itineraries
Content-Type: application/json
Accept: application/json

{
  "price": 150000,
  "state": "EDITION",
  "flights": [
    {
      "flightId": 3,
      "flightOrder": 1
    }
  ]
}


### 29. Publicar itinerario EDITION
# Esperado: 200 OK con state = PUBLIC.
PUT {{baseUrl}}/api/itineraries/{{crearItinerarioEditionParaPublicar.response.body.$.itineraryId}}
Content-Type: application/json
Accept: application/json

{
  "price": 150000,
  "state": "PUBLIC",
  "flights": [
    {
      "flightId": 3,
      "flightOrder": 1
    }
  ]
}


### 30. Intentar editar itinerario PUBLIC
# Esperado: 409 Conflict.
# "Only itineraries in EDITION state can be edited."
PUT {{baseUrl}}/api/itineraries/1
Content-Type: application/json
Accept: application/json

{
  "price": 999999,
  "state": "PUBLIC",
  "flights": [
    {
      "flightId": 1,
      "flightOrder": 1
    }
  ]
}


### 31. Intentar regresar PUBLIC a EDITION
# Esperado: 409 Conflict.
# "Published itineraries cannot return to edition."
PUT {{baseUrl}}/api/itineraries/1
Content-Type: application/json
Accept: application/json

{
  "price": 180000,
  "state": "EDITION",
  "flights": [
    {
      "flightId": 1,
      "flightOrder": 1
    }
  ]
}


### 32. Intentar cerrar manualmente itinerario PUBLIC
# Esperado: 409 Conflict.
# "Itineraries cannot be manually closed from itinerary management."
PUT {{baseUrl}}/api/itineraries/1
Content-Type: application/json
Accept: application/json

{
  "price": 180000,
  "state": "CLOSED",
  "flights": [
    {
      "flightId": 1,
      "flightOrder": 1
    }
  ]
}


### 33. Intentar editar itinerario CLOSED
# Esperado: 409 Conflict.
# "Closed itineraries cannot be modified."
PUT {{baseUrl}}/api/itineraries/5
Content-Type: application/json
Accept: application/json

{
  "price": 210500,
  "state": "CLOSED",
  "flights": [
    {
      "flightId": 5,
      "flightOrder": 1
    }
  ]
}


### 34. Intentar cambiar CLOSED a PUBLIC
# Esperado: 409 Conflict.
# "Closed itineraries cannot be modified."
PUT {{baseUrl}}/api/itineraries/5
Content-Type: application/json
Accept: application/json

{
  "price": 210000,
  "state": "PUBLIC",
  "flights": [
    {
      "flightId": 5,
      "flightOrder": 1
    }
  ]
}


### 35. Cerrar vuelo relacionado con itinerario PUBLIC
# flight_id = 4 pertenece al itinerary_id = 3.
# Esperado: 200 OK con vuelo CLOSED; el backend cierra itinerarios relacionados automaticamente.
PATCH {{baseUrl}}/api/flights/4/state
Content-Type: application/json
Accept: application/json

{
  "state": "CLOSED"
}


### 36. Verificar itinerario cerrado automaticamente por cierre de vuelo
# Esperado: 200 OK con state = CLOSED.
GET {{baseUrl}}/api/itineraries/3
Accept: application/json


### 37. Busqueda publica solo devuelve PUBLIC
# Esperado: 200 OK sin itinerarios EDITION ni CLOSED.
GET {{baseUrl}}/api/itineraries/search?originCode=SJO&destinationCode=MIA
Accept: application/json


### 38. Busqueda publica sin filtros
# Esperado: 200 OK. Solo itinerarios PUBLIC.
GET {{baseUrl}}/api/itineraries/search
Accept: application/json


### 39. Busqueda publica por departureCode
# Esperado: 200 OK con itinerarios cuyo primer vuelo sale de SJO.
GET {{baseUrl}}/api/itineraries/search?departureCode=SJO
Accept: application/json


### 40. Busqueda publica por arrivalCode
# Esperado: 200 OK con itinerarios cuyo ultimo vuelo llega a BOG.
GET {{baseUrl}}/api/itineraries/search?arrivalCode=BOG
Accept: application/json


### 41. Busqueda publica por departureDate
# Esperado: 200 OK con primera salida el 2026-06-10.
GET {{baseUrl}}/api/itineraries/search?departureDate=2026-06-10
Accept: application/json


### 42. Busqueda publica de itinerarios directos
# Esperado: 200 OK con totalFlights = 1.
GET {{baseUrl}}/api/itineraries/search?stops=direct
Accept: application/json


### 43. Busqueda publica de itinerarios con escalas
# Esperado: 200 OK con totalFlights > 1.
GET {{baseUrl}}/api/itineraries/search?stops=with_stops
Accept: application/json


### 44. Busqueda publica ordenada por precio
# Esperado: 200 OK ordenado por price ascendente.
GET {{baseUrl}}/api/itineraries/search?sortBy=price
Accept: application/json


### 45. Busqueda publica ordenada por duracion
# Esperado: 200 OK ordenado por duracion total ascendente.
GET {{baseUrl}}/api/itineraries/search?sortBy=duration
Accept: application/json


### 46. Busqueda publica con stops invalido
# Esperado: 400 Bad Request.
GET {{baseUrl}}/api/itineraries/search?stops=invalid
Accept: application/json


### 47. Busqueda publica con sortBy invalido
# Esperado: 400 Bad Request.
GET {{baseUrl}}/api/itineraries/search?sortBy=invalid
Accept: application/json


### 48. Busqueda admin sin filtros
# Esperado: 200 OK incluyendo EDITION, PUBLIC y CLOSED.
GET {{baseUrl}}/api/itineraries/admin/search
Accept: application/json


### 49. Busqueda admin por itineraryId
# Esperado: 200 OK con itineraryId = 1.
GET {{baseUrl}}/api/itineraries/admin/search?itineraryId=1
Accept: application/json


### 50. Busqueda admin por departureCode
# Esperado: 200 OK con primer vuelo saliendo de SJO.
GET {{baseUrl}}/api/itineraries/admin/search?departureCode=SJO
Accept: application/json


### 51. Busqueda admin por arrivalCode
# Esperado: 200 OK con ultimo vuelo llegando a MEX.
GET {{baseUrl}}/api/itineraries/admin/search?arrivalCode=MEX
Accept: application/json


### 52. Busqueda admin por state
# Esperado: 200 OK con itinerarios EDITION.
GET {{baseUrl}}/api/itineraries/admin/search?state=EDITION
Accept: application/json


### 53. Busqueda admin con state invalido
# Esperado: 400 Bad Request.
GET {{baseUrl}}/api/itineraries/admin/search?state=DRAFT
Accept: application/json
