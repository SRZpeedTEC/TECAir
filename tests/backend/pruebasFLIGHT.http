@baseUrl = http://localhost:5000

### 1. Health check
GET {{baseUrl}}/health
Accept: application/json


### 2. Crear vuelo sin arrivalDatetime ni miles
# Esperado: 201 Created.
# La respuesta debe incluir arrivalDatetime y miles calculados por el backend.
# Requiere que existan el avion TI-TEC01, los aeropuertos SJO/MIA y su airport_connection.
# @name crearVueloCalculado
POST {{baseUrl}}/api/flights
Content-Type: application/json
Accept: application/json

{
  "planePlate": "TI-TEC01",
  "airportDepartsFromId": "SJO",
  "airportArrivesToId": "MIA",
  "state": "OPEN",
  "gate": "A9",
  "departureDatetime": "2026-07-01T08:00:00"
}


### 3. Consultar vuelos OPEN por aeropuerto de salida
# Esperado: 200 OK con vuelos OPEN saliendo de SJO.
# Los vuelos deben incluir arrivalDatetime y miles calculados/almacenados.
GET {{baseUrl}}/api/flights/open?departureCode=SJO
Accept: application/json


### 4. Crear vuelo sin state
# Esperado: 201 Created con state = UPCOMING.
POST {{baseUrl}}/api/flights
Content-Type: application/json
Accept: application/json

{
  "planePlate": "TI-TEC03",
  "airportDepartsFromId": "LIR",
  "airportArrivesToId": "MEX",
  "gate": "L9",
  "departureDatetime": "2026-09-01T08:00:00"
}


### 5. Crear vuelo con state invalido
# Esperado: 400 Bad Request.
POST {{baseUrl}}/api/flights
Content-Type: application/json
Accept: application/json

{
  "planePlate": "TI-TEC02",
  "airportDepartsFromId": "SJO",
  "airportArrivesToId": "MIA",
  "state": "BOARDING",
  "gate": "A11",
  "departureDatetime": "2026-09-03T08:00:00"
}


### 6. Crear vuelo con aeropuerto_connection faltante
# Esperado: 404 Not Found con:
# "There is no configured airport connection for SJO to ZZZ."
# Nota: con los datos semilla todos los pares existentes tienen conexion.
# Para ejecutar este caso exacto, ZZZ debe existir como aeropuerto sin fila en airport_connection.
POST {{baseUrl}}/api/flights
Content-Type: application/json
Accept: application/json

{
  "planePlate": "TI-TEC02",
  "airportDepartsFromId": "SJO",
  "airportArrivesToId": "ZZZ",
  "state": "OPEN",
  "gate": "A12",
  "departureDatetime": "2026-09-04T08:00:00"
}


### 7. Crear vuelo sin avion
# Esperado: 400 Bad Request.
POST {{baseUrl}}/api/flights
Content-Type: application/json
Accept: application/json

{
  "planePlate": "",
  "airportDepartsFromId": "SJO",
  "airportArrivesToId": "MIA",
  "state": "OPEN",
  "gate": "A1",
  "departureDatetime": "2026-07-02T08:00:00"
}


### 8. Crear vuelo con avion inexistente
# Esperado: 404 Not Found.
POST {{baseUrl}}/api/flights
Content-Type: application/json
Accept: application/json

{
  "planePlate": "NO-EXISTE",
  "airportDepartsFromId": "SJO",
  "airportArrivesToId": "MIA",
  "state": "OPEN",
  "gate": "A1",
  "departureDatetime": "2026-07-02T08:00:00"
}


### 9. Crear vuelo con aeropuerto de llegada inexistente
# Esperado: 404 Not Found.
POST {{baseUrl}}/api/flights
Content-Type: application/json
Accept: application/json

{
  "planePlate": "TI-TEC01",
  "airportDepartsFromId": "SJO",
  "airportArrivesToId": "XXX",
  "state": "OPEN",
  "gate": "A1",
  "departureDatetime": "2026-07-02T08:00:00"
}


### 10. Crear vuelo con aeropuertos iguales
# Esperado: 400 Bad Request.
POST {{baseUrl}}/api/flights
Content-Type: application/json
Accept: application/json

{
  "planePlate": "TI-TEC01",
  "airportDepartsFromId": "SJO",
  "airportArrivesToId": "SJO",
  "state": "OPEN",
  "gate": "A1",
  "departureDatetime": "2026-07-02T08:00:00"
}


### 11. Crear vuelo sin departureDatetime
# Esperado: 400 Bad Request.
POST {{baseUrl}}/api/flights
Content-Type: application/json
Accept: application/json

{
  "planePlate": "TI-TEC01",
  "airportDepartsFromId": "SJO",
  "airportArrivesToId": "MIA",
  "state": "OPEN",
  "gate": "A1"
}


### 12. Crear vuelo valido para pruebas de conflicto
# Esperado: 201 Created.
# Este vuelo reserva el avion TI-TEC01 y la puerta Z1 en SJO a las 08:00.
POST {{baseUrl}}/api/flights
Content-Type: application/json
Accept: application/json

{
  "planePlate": "TI-TEC01",
  "airportDepartsFromId": "SJO",
  "airportArrivesToId": "MIA",
  "state": "OPEN",
  "gate": "Z1",
  "departureDatetime": "2026-07-10T08:00:00"
}


### 13. Crear vuelo con el mismo avion y horario traslapado
# Esperado: 409 Conflict.
POST {{baseUrl}}/api/flights
Content-Type: application/json
Accept: application/json

{
  "planePlate": "TI-TEC01",
  "airportDepartsFromId": "SJO",
  "airportArrivesToId": "MIA",
  "state": "OPEN",
  "gate": "Z2",
  "departureDatetime": "2026-07-10T10:00:00"
}


### 14. Crear vuelo con misma puerta y misma hora de salida
# Esperado: 409 Conflict.
POST {{baseUrl}}/api/flights
Content-Type: application/json
Accept: application/json

{
  "planePlate": "TI-TEC02",
  "airportDepartsFromId": "SJO",
  "airportArrivesToId": "MIA",
  "state": "OPEN",
  "gate": "z1",
  "departureDatetime": "2026-07-10T08:00:00"
}


### 15. Actualizar vuelo sin arrivalDatetime ni miles
# Esperado: 200 OK.
# flightId viene de la ruta; arrivalDatetime y miles se recalculan.
PUT {{baseUrl}}/api/flights/3
Content-Type: application/json
Accept: application/json

{
  "planePlate": "TI-TEC03",
  "airportDepartsFromId": "SJO",
  "airportArrivesToId": "LIR",
  "state": "OPEN",
  "gate": "A8",
  "departureDatetime": "2026-06-11T07:30:00"
}


### 16. Actualizar vuelo recalculando por nuevo origen/destino/salida
# Esperado: 200 OK con arrivalDatetime y miles distintos si cambia la conexion.
PUT {{baseUrl}}/api/flights/3
Content-Type: application/json
Accept: application/json

{
  "planePlate": "TI-TEC03",
  "airportDepartsFromId": "SJO",
  "airportArrivesToId": "PTY",
  "state": "OPEN",
  "gate": "A8",
  "departureDatetime": "2026-06-11T09:00:00"
}


### 17. Actualizar vuelo inexistente
# Esperado: 404 Not Found.
PUT {{baseUrl}}/api/flights/9999
Content-Type: application/json
Accept: application/json

{
  "planePlate": "TI-TEC03",
  "airportDepartsFromId": "SJO",
  "airportArrivesToId": "LIR",
  "state": "OPEN",
  "gate": "A8",
  "departureDatetime": "2026-06-11T07:30:00"
}


### 18. Actualizar vuelo causando traslape de avion
# Vuelo 1 usa TI-TEC01 desde 2026-06-10T08:00:00 hasta su llegada calculada.
# Esperado: 409 Conflict.
PUT {{baseUrl}}/api/flights/3
Content-Type: application/json
Accept: application/json

{
  "planePlate": "TI-TEC01",
  "airportDepartsFromId": "SJO",
  "airportArrivesToId": "LIR",
  "state": "OPEN",
  "gate": "A8",
  "departureDatetime": "2026-06-10T08:30:00"
}


### 19. Actualizar vuelo causando conflicto de puerta
# Vuelo 1 usa la puerta A1 en SJO a las 08:00.
# Esperado: 409 Conflict.
PUT {{baseUrl}}/api/flights/3
Content-Type: application/json
Accept: application/json

{
  "planePlate": "TI-TEC03",
  "airportDepartsFromId": "SJO",
  "airportArrivesToId": "LIR",
  "state": "OPEN",
  "gate": "A1",
  "departureDatetime": "2026-06-10T08:00:00"
}


### 20. Preparar vuelo no usado para prueba de borrado
# @name crearVueloParaBorrar
# Esperado: 201 Created.
POST {{baseUrl}}/api/flights
Content-Type: application/json
Accept: application/json

{
  "planePlate": "TI-TEC03",
  "airportDepartsFromId": "LIR",
  "airportArrivesToId": "SJO",
  "state": "OPEN",
  "gate": "L8",
  "departureDatetime": "2026-08-01T08:00:00"
}


### 21. Eliminar vuelo existente no usado
# Esperado: 204 No Content.
DELETE {{baseUrl}}/api/flights/{{crearVueloParaBorrar.response.body.$.flightId}}
Accept: application/json


### 22. Eliminar vuelo inexistente
# Esperado: 404 Not Found.
DELETE {{baseUrl}}/api/flights/9999
Accept: application/json


### 23. Eliminar vuelo usado en itinerario
# Vuelo 1 pertenece a itinerarios en los datos semilla.
# Esperado: 409 Conflict.
DELETE {{baseUrl}}/api/flights/1
Accept: application/json
