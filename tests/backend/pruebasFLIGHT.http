@baseUrl = http://localhost:5000

### 1. Health check
GET {{baseUrl}}/health
Accept: application/json


### 2. Crear vuelo directo valido
# Esperado: 201 Created.
# Requiere que existan el avion TI-TEC01 y los aeropuertos SJO y MIA.
POST {{baseUrl}}/api/flights
Content-Type: application/json
Accept: application/json

{
  "planePlate": "TI-TEC01",
  "airportDepartsFromId": "SJO",
  "airportArrivesToId": "MIA",
  "state": "OPEN",
  "gate": "A9",
  "departureDatetime": "2026-07-01T08:00:00",
  "arrivalDatetime": "2026-07-01T12:30:00"
}


### 3. Consultar vuelos OPEN por aeropuerto de salida
# Esperado: 200 OK con vuelos OPEN saliendo de SJO, ordenados por salida.
# No debe incluir vuelos UPCOMING.
GET {{baseUrl}}/api/flights/open?departureCode=SJO
Accept: application/json


### 3.1 Crear vuelo sin state
# Esperado: 201 Created con state = UPCOMING.
POST {{baseUrl}}/api/flights
Content-Type: application/json
Accept: application/json

{
  "planePlate": "TI-TEC03",
  "airportDepartsFromId": "LIR",
  "airportArrivesToId": "MEX",
  "gate": "L9",
  "departureDatetime": "2026-09-01T08:00:00",
  "arrivalDatetime": "2026-09-01T11:00:00"
}


### 3.2 Crear vuelo con state UPCOMING
# Esperado: 201 Created con state = UPCOMING.
POST {{baseUrl}}/api/flights
Content-Type: application/json
Accept: application/json

{
  "planePlate": "TI-TEC02",
  "airportDepartsFromId": "SJO",
  "airportArrivesToId": "MEX",
  "state": "UPCOMING",
  "gate": "A10",
  "departureDatetime": "2026-09-02T08:00:00",
  "arrivalDatetime": "2026-09-02T11:30:00"
}


### 3.3 Crear vuelo con state invalido
# Esperado: 400 Bad Request.
POST {{baseUrl}}/api/flights
Content-Type: application/json
Accept: application/json

{
  "planePlate": "TI-TEC02",
  "airportDepartsFromId": "SJO",
  "airportArrivesToId": "MIA",
  "state": "BOARDING",
  "gate": "A11",
  "departureDatetime": "2026-09-03T08:00:00",
  "arrivalDatetime": "2026-09-03T12:30:00"
}


### 4. Consultar vuelos OPEN con codigo en minuscula
# Esperado: 200 OK; la busqueda es case-insensitive.
GET {{baseUrl}}/api/flights/open?departureCode=sjo
Accept: application/json


### 5. Consultar vuelos OPEN sin departureCode
# Esperado: 400 Bad Request.
GET {{baseUrl}}/api/flights/open
Accept: application/json


### 6. Consultar vuelos disponibles sin filtros
# Esperado: 200 OK con vuelos UPCOMING y OPEN. No debe incluir CLOSED.
GET {{baseUrl}}/api/flights/available
Accept: application/json


### 7. Consultar vuelos disponibles por origen y destino
# Esperado: 200 OK con vuelos disponibles de SJO a PTY.
GET {{baseUrl}}/api/flights/available?originCode=SJO&destinationCode=PTY
Accept: application/json


### 8. Consultar vuelos disponibles por flightId
# Esperado: 200 OK con flightId = 1 si esta UPCOMING u OPEN.
GET {{baseUrl}}/api/flights/available?flightId=1
Accept: application/json


### 9. Consultar vuelos disponibles con flightId CLOSED
# Vuelo 6 esta CLOSED en seed data.
# Esperado: 200 OK con lista vacia.
GET {{baseUrl}}/api/flights/available?flightId=6
Accept: application/json


### 10. Consultar vuelos disponibles combinando origen, destino y flightId
# Esperado: 200 OK con flightId = 1 si sale de SJO y llega a PTY.
GET {{baseUrl}}/api/flights/available?originCode=SJO&destinationCode=PTY&flightId=1
Accept: application/json


### 11. PATCH estado UPCOMING -> OPEN
# Vuelo 7 esta UPCOMING en seed data.
# Esperado: 200 OK con state = OPEN y sin modificar los demas campos.
PATCH {{baseUrl}}/api/flights/7/state
Content-Type: application/json
Accept: application/json

{
  "state": "OPEN"
}


### 12. PATCH estado OPEN -> CLOSED
# Esperado: 200 OK con state = CLOSED.
PATCH {{baseUrl}}/api/flights/7/state
Content-Type: application/json
Accept: application/json

{
  "state": "CLOSED"
}


### 13. PATCH estado invalido
# Esperado: 400 Bad Request.
PATCH {{baseUrl}}/api/flights/7/state
Content-Type: application/json
Accept: application/json

{
  "state": "BOARDING"
}


### 14. PATCH estado de vuelo inexistente
# Esperado: 404 Not Found.
PATCH {{baseUrl}}/api/flights/9999/state
Content-Type: application/json
Accept: application/json

{
  "state": "OPEN"
}


### 15. PATCH intentando CLOSED -> UPCOMING
# Vuelo 7 quedo CLOSED en la prueba 12.
# Esperado: 400 Bad Request.
PATCH {{baseUrl}}/api/flights/7/state
Content-Type: application/json
Accept: application/json

{
  "state": "UPCOMING"
}


### 16. PATCH intentando CLOSED -> OPEN
# Vuelo 7 quedo CLOSED en la prueba 12.
# Esperado: 400 Bad Request.
PATCH {{baseUrl}}/api/flights/7/state
Content-Type: application/json
Accept: application/json

{
  "state": "OPEN"
}


### 17. Crear vuelo sin avion
# Esperado: 400 Bad Request.
POST {{baseUrl}}/api/flights
Content-Type: application/json
Accept: application/json

{
  "planePlate": "",
  "airportDepartsFromId": "SJO",
  "airportArrivesToId": "MIA",
  "state": "OPEN",
  "gate": "A1",
  "departureDatetime": "2026-07-02T08:00:00",
  "arrivalDatetime": "2026-07-02T12:30:00"
}


